# Database (local file by default; use a Turso URL + token when deployed)
DATABASE_URL=file:./data/tnea.db
# DATABASE_AUTH_TOKEN=
# Optional Turso read replicas (India region closest to users):
# TURSO_READ_REPLICA_URL=libsql://tnea-compass-india.turso.io

# Public site URL used for metadata, auth callbacks and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production: 32+ random bytes. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Optional; defaults to NEXT_PUBLIC_SITE_URL
# BETTER_AUTH_URL=http://localhost:3000

# Optional: Google OAuth authentication
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Web Push Notifications for counselling deadline alerts
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@tneacompass.in

# Optional: enable the grounded assistant (not required)
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Optional: transactional email for password reset and verification
# Create a key at https://resend.com and verify the sending domain first.
# RESEND_API_KEY=
# EMAIL_FROM=TNEA Compass <no-reply@your-domain.example>

# Optional: shared rate limiting for the public assistant endpoint
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
